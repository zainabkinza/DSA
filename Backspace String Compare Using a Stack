#include<iostream>
using namespace std;
class Stack{
    char arr[500];
    int top;
public:
    Stack(){
        top = -1;
    }
    void push(char c){
        arr[++top] = c;
    }
    char pop(){
        return arr[top--];
    }
    bool empty(){
        return top == -1;
    }
    int size(){
        return top + 1;
    }
};

void build(char s[], char out[]){
    Stack st;
    for(int i = 0; s[i] != '\0'; i++){
        if(s[i] == '#'){
            if(!st.empty()){
                st.pop();
            }
        }else{
            st.push(s[i]);
        }
    }
    int n = st.size();
    out[n] = '\0';
    for(int i = n - 1; i >= 0; i--){
        out[i] = st.pop();
    }
}

bool backspaceCompare(char s[], char t[]){
    char a[500];
    char b[500];
    build(s, a);
    build(t, b);
    int i = 0;
    while(a[i] != '\0' && b[i] != '\0'){
        if(a[i] != b[i]){
            return false;
        }
        i++;
    }
    return a[i] == b[i];
}

int main(){
    char s[500];
    char t[500];
    cout<<"Enter string s: ";
    cin.getline(s, 500);
    cout<<"Enter string t: ";
    cin.getline(t, 500);
    if(backspaceCompare(s, t)){
        cout<<"true"<<endl;
    }else{
        cout<<"false"<<endl;
    }
    return 0;
}
