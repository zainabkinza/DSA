#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* prev;
    Node* next;
    
    Node(int val) {
        data = val;
        prev = NULL;
        next = NULL;
    }
};

class DoublyList {
public:
    Node* head;
    Node* tail;
    
    DoublyList() {
        head = NULL;
        tail = NULL;
    }

    void push(int val) {
        Node* newNode = new Node(val);
        if(head == NULL) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
    }

    void display(string name) {
        cout << name << ": ";
        Node* temp = head;
        while(temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
    
    void concatenate(DoublyList &M) {
        if(head == NULL) { 
            head = M.head;
            tail = M.tail;
        } else if(M.head != NULL) { 
            tail->next = M.head;
            M.head->prev = tail;
            tail = M.tail;
        }
    }
};

int main() {
    DoublyList L, M, N;
    
    for(int i = 2; i <= 10; i += 2) {
        L.push(i);
    }
    for(int i = 1; i <= 9; i += 2) {
        M.push(i);
    }
    
    L.display("List L"); 
    M.display("List M"); 
    
    N.head = L.head;
    N.tail = L.tail;
    
    N.concatenate(M);
    N.display("List N");
    
    return 0;
}
