#include<iostream>
using namespace std;

int main(){

int arr_2D [3][3];
int arr_1D [9];

cout<<"Enter the values for a 2D Array: "<<endl;
for (int i=0; i<3; i++){
	for (int j=0; j<3; j++){
		cin>>arr_2D [i][j];
	}
}

int index = 0;
for (int j=0; j<3; j++){
	for (int i=0; i<3; i++){
		arr_1D[index] = arr_2D[i][j];
		index++;
	}
}

cout<<"\nColumn Major Order: "<<endl;
for (int i=0; i<9; i++){
	cout<< arr_1D[i] <<" ";
}
}
