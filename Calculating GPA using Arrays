#include<iostream>
using namespace std;
int main(){
float marks [5][5] = {{3.66, 3.33, 4.0, 3.0, 2.66},
                      {3.33, 3.0, 3.66, 3.0, 0.0},
					  {4.0, 3.66, 2.66, 0.0, 0.0},
					  {2.66, 2.33, 4.0, 0.0, 0.0},
					  {3.33, 3.66, 4.0, 3.0, 3.33}};

int numCourses[5] = {5, 3, 2, 2, 5};
float chrs = 3;
float gpa[5];
for (int i=0; i<5; i++){
	float sum=0.0;
	float total_chrs = numCourses[i]*chrs;
	for (int j=0; j<numCourses[i]; j++){
		sum = sum + (marks[i][j]*chrs);
	}
	gpa[i] = sum/total_chrs;
}
for (int i=0; i<5; i++){
cout<<"GPA of student "<<i+1<<": "<<gpa[i]<<endl;
}
}
