#include <iostream>
using namespace std;

struct ListNode {
    int val;
    ListNode *next;
    ListNode(int x) : val(x), next(nullptr) {}
};

ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
    ListNode dummy(0); 
    ListNode* tail = &dummy;

    while(list1 && list2){
        if(list1->val <= list2->val){
            tail->next = list1;
            list1 = list1->next;
        } else {
            tail->next = list2;
            list2 = list2->next;
        }
        tail = tail->next;
    }

	if (list1 != nullptr) {
    tail->next = list1;
	} else {
    tail->next = list2;
	}

    return dummy.next;
}

ListNode* createList(int arr[], int n) {
    ListNode dummy(0);
    ListNode* tail = &dummy;
    for(int i = 0; i < n; i++){
        tail->next = new ListNode(arr[i]);
        tail = tail->next;
    }
    return dummy.next;
}

void printList(ListNode* head) {
    while(head){
        cout << head->val;
        if(head->next) cout << " -> ";
        head = head->next;
    }
    cout << endl;
}

int main() {
    int arr1[] = {1, 2, 4};
    int arr2[] = {1, 3, 4};

    ListNode* list1 = createList(arr1, 3);
    ListNode* list2 = createList(arr2, 3);

    cout << "List1: ";
    printList(list1);
    cout << "List2: ";
    printList(list2);

    ListNode* merged = mergeTwoLists(list1, list2);

    cout << "Merged: ";
    printList(merged);

    return 0;
}
