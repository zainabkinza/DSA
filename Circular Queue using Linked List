#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;
    Node(int val) {
        data = val;
        next = NULL;
    }
};

class CircularQueue {
    Node* front;
    Node* rear;
public:
    CircularQueue() {
        front = NULL;
        rear = NULL;
    }

    void enqueue(int val) {
        Node* newNode = new Node(val);
        
        if(front == NULL) { 
            front = rear = newNode;
            rear->next = front; 
        }
        else {
            rear->next = newNode; 
            rear = newNode;     
            rear->next = front;   
        }
        cout << val << " added" << endl;
    }

    void dequeue() {
        if(front == NULL) {
            cout << "Queue Empty" << endl;
            return;
        }
        
        cout << front->data << " removed" << endl;
        
        if(front == rear) { 
            delete front;
            front = rear = NULL;
        }
        else {
            Node* temp = front;
            front = front->next; 
            rear->next = front;  
            delete temp;
        }
    }

    void display() {
        if(front == NULL) {
            cout << "Queue Empty" << endl;
            return;
        }
        
        Node* temp = front;
        cout << "Queue: ";
        do {
            cout << temp->data << " ";
            temp = temp->next;
        } while(temp != front);
        cout << endl;
    }
};

int main() {
    CircularQueue q;
    
    q.enqueue(1);
    q.enqueue(2);
    q.enqueue(3);
    q.display();
    
    q.dequeue();
    q.display();

    return 0;
}
