#include <iostream>
using namespace std;

void bubbleSort(int arr[], int n) {
    for(int i = 0; i < n-1; i++) {
        for(int j = 0; j < n-i-1; j++) {
            if(arr[j] > arr[j+1]) {
                int temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }
}

void maxToys(int arr[], int n, int k) {
    bubbleSort(arr, n); 

    int count = 0;
    int sum = 0; 

    for(int i = 0; i < n; i++) {
        if(sum + arr[i] <= k) { 
            sum += arr[i];
            count++;
        } else {
            break;
        }
    }

    cout << "Maximum toys: " << count << endl;
    cout << "Total money spent: " << sum << endl;
    cout << "Money left: " << k - sum << endl;
}

int main() {
    int n, k;
    cout << "Enter N and K: ";
    cin >> n >> k;

    int arr[n];
    cout << "Enter toy prices: ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    maxToys(arr, n, k);
    return 0;
}
